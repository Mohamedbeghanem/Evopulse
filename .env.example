# Optional. Demo works offline without any key — seed scenario uses a deterministic extractor.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# DB_PATH=./data/evopulse.db
# PORT=3000

# Agent runtime. Default is the deterministic Command Router.
# EVOPULSE_AGENT_PROVIDER=deterministic
# EVOPULSE_AGENT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_ALLOWED_PROVIDERS=
# OPENROUTER_DATA_POLICY=standard
# OPENROUTER_ALLOW_PROVIDER_FALLBACK=true
# OPENROUTER_FAST_MODEL=
# OPENROUTER_REASONING_MODEL=
# OPENROUTER_HTTP_REFERER=
# EVOPULSE_AGENT_TIMEOUT_MS=20000
# EVOPULSE_AGENT_MAX_OUTPUT=1200
