# Optional. Demo works offline without any key — seed scenario uses a deterministic extractor.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# EVOPULSE_AGENT_RUNTIME=deterministic
# OPENROUTER_API_KEY=
# Free-only by default. Unset = nvidia/nemotron-3-super-120b-a12b:free, then free fallbacks
# google/gemma-4-31b-it:free, qwen/qwen3.8-27b:free. Non-free ids are refused unless OPENROUTER_ALLOW_PAID=true.
# OPENROUTER_MODEL=
# Comma list of extra fallbacks (free ids only unless OPENROUTER_ALLOW_PAID=true)
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_ALLOW_PAID=false
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# standard | no_training | allowlisted_only (allowlisted_only requires OPENROUTER_ALLOWED_PROVIDERS)
# OPENROUTER_DATA_POLICY=standard
# OPENROUTER_ALLOWED_PROVIDERS=
# OPENROUTER_ALLOW_PROVIDER_FALLBACK=true
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# EVOPULSE_LLM_API_KEY=
# EVOPULSE_LLM_BASE_URL=
# EVOPULSE_LLM_MODEL=
# DB_PATH=./data/evopulse.db
# CONTROL_DB_PATH=./data/control.db
# WORKSPACE_DB_DIR=./data/workspaces
# PORT=3000
# --- Connectors & Plugins (docs/CONNECTORS.md) ---
# EVOPULSE_SECRETS_KEY=            # encrypts connector secrets at rest
# EVOPULSE_CONNECTOR_ENV_WORKSPACES= # workspace ids (or *) allowed to use the env credentials below
# EVOPULSE_IMAP_HOST=
# EVOPULSE_IMAP_PORT=993
# EVOPULSE_IMAP_USER=
# EVOPULSE_IMAP_PASSWORD=
# EVOPULSE_IMAP_MAILBOX=INBOX
# EVOPULSE_IMAP_TLS=true
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# EVOPULSE_MCP_ALLOW_PRIVATE=false  # true only for local MCP servers in dev

# --- MCP (admin plugins) ---
# Public origin used for OAuth redirect URIs (/api/connectors/oauth/callback). Defaults to the request host.
# EVOPULSE_PUBLIC_URL=https://evopulse.example.com
# stdio MCP servers (local processes): off by default, admin-only, never on serverless.
# EVOPULSE_MCP_STDIO=true
# EVOPULSE_MCP_STDIO_ALLOWLIST=npx,uvx
